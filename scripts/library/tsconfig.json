{
  "compilerOptions": {
    "target": "es2015",
    "module": "commonjs",
    "moduleResolution": "node",
    "declaration": false,
    "sourceMap": false,
    "inlineSources": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "strictNullChecks": true,
    "types": [
      "jasmine",
      "node"
    ],
    "lib": [
      "dom",
      "es2018"
    ],
    "ignoreDeprecations": "6.0"    // <-- THIS LINE QUIETS THE DEPRECATION ERRORS
  }
}
