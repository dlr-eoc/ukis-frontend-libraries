{
  "name": "ukis-frontend-libraries",
  "version": "16.0.1-next.3",
  "license": "Apache-2.0",
  "author": "Team UKIS",
  "projectsScope": "@dlr-eoc/",
  "bugs": {
    "url": "https://github.com/dlr-eoc/ukis-frontend-libraries/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dlr-eoc/ukis-frontend-libraries"
  },
  "keywords": [
    "angular",
    "Clarity Design",
    "openlayers",
    "mapping",
    "OGC"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo-maps",
    "library": "node scripts/library/index.js",
    "build": "npm run library -- --build",
    "test": "npm run library -- --test",
    "schematics:test": "npm run schematics:test --workspace=projects/ngx-ukis-ui-clarity",
    "ui-clarity:build": "npm run library -- --build --projects=ngx-ukis-ui-clarity",
    "syncVersionsInWorkspaces": "npm run library -- --set-source",
    "build:scripts": "npx tsc -p scripts/library/tsconfig.json",
    "lint": "ng lint",
    "compodoc": "compodoc -p tsconfig.doc.json -a projects/ngx-ukis-ui-clarity/schematics/ng-add/files/src/assets  -n \"UKIS Frontend libraries\"",
    "compodoc-serve": "compodoc -r 8081 -s",
    "build:license": "npx license-checker --json --out ./projects/demo-maps/src/assets/licenses.json",
    "postinstall": "patch-package"
  },
  "private": true,
  "packageManager": "npm@11.0.0",
  "dependencies": {
    "@angular-devkit/core": "^22.2.6",
    "@angular-devkit/schematics": "^22.2.6",
    "@angular/animations": "^22.2.4",
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/platform-browser-dynamic": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@clr/angular": "^18.5.0",
    "@clr/ui": "^18.5.0",
    "@fontsource/metropolis": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@schematics/angular": "^22.2.6",
    "@webcomponents/webcomponentsjs": "^2.8.0",
    "jsonix": "^3.0.0",
    "luxon": "^3.7.2",
    "ogc-schemas": "^2.6.1",
    "ol": "^v10.9.0",
    "proj4": "^2.20.8",
    "rxjs": "~7.8.2",
    "tslib": "^2.6.3",
    "w3c-schemas": "^1.4.0",
    "xmlserializer": "^0.6.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.4",
    "@vitest/browser-playwright": "^4.1.11",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.2.6",
    "patch-package": "^8.0.1",
    "playwright": "^1.62.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  },
  "workspaces": [
    "scripts/library",
    "projects/cookie-alert",
    "projects/base-layers-raster",
    "projects/map-ol",
    "projects/services-layers",
    "projects/services-util-store",
    "projects/services-ogc",
    "projects/services-map-state",
    "projects/demo-auth",
    "projects/demo-maps",
    "projects/utils-browser",
    "projects/utils-maps",
    "projects/utils-ogc",
    "projects/map-three",
    "projects/shared-assets",
    "projects/map-cesium",
    "projects/utilities",
    "projects/map-maplibre",
    "projects/ngx-ukis-utilities",
    "projects/ngx-ukis-ui-clarity"
  ],
  "engines": {
    "node": ">= 20.15.1",
    "npm": ">= 10.7.0"
  }
}