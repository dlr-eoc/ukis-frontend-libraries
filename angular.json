      "projectType": "library",
      "root": "projects/base-layers-raster",
      "sourceRoot": "projects/base-layers-raster/src",
      "prefix": "ngx-ukis",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/base-layers-raster/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/base-layers-raster/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/base-layers-raster/tsconfig.spec.json"
          }
        }
      }
    },
